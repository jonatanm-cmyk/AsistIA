# =============================================================================
# AsistIA · backoffice · variables de entorno
# =============================================================================
# Copia este archivo a .env.local y rellena los valores. Nada de esto se
# commitea: .env.local está en .gitignore.
#
# Los datos de base de datos son los mismos que el perfil del equipo
# Automatizaciones\instancias\asistia.env (bloque ASISTIA_PG*).
#
# -----------------------------------------------------------------------------
# 1. Base de datos  ·  ESTA ES LA ÚNICA CADENA QUE HAY QUE CAMBIAR
# -----------------------------------------------------------------------------
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?sslmode=no-verify
#
# HOST: usa el del POOLER (aws-0-<región>.pooler.supabase.com), no
#   db.<proyecto>.supabase.co. La conexión directa de Supabase es solo IPv6
#   salvo que se contrate el añadido de IPv4, y desde una máquina sin IPv6 se
#   queda en timeout sin decir por qué.
#
# USUARIO: por el pooler es postgres.<proyecto>, no `postgres` a secas.
#
# PUERTO 5432, no 6543. Y el motivo NO es "pooler sí o pooler no", es el MODO:
#   5432 -> modo SESIÓN       conserva estado de sesión  ✔
#   6543 -> modo TRANSACCIÓN                             ✘
# Este backoffice fija `app.empresa_id` con set_config en cada transacción, y
# los flujos de n8n dependen de lo mismo para su RLS.
#
# sslmode=no-verify, NO `require`: las versiones nuevas de `pg` tratan `require`
# como `verify-full` y el certificado de Supabase no valida contra la CA del
# sistema. La conexión sigue cifrada; lo que se omite es validar el certificado.
#
# CONTRASEÑA: codifica en porcentaje los caracteres especiales.
#   @ -> %40    # -> %23    : -> %3A    / -> %2F    ? -> %3F    % -> %25
# La de este proyecto empieza por '@': sin codificar, la URL se parte por ahí y
# el error que sale es "password authentication failed", que despista.
DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASEÑA_CODIFICADA@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=no-verify

# Esquema donde vive AsistIA. No lo cambies salvo que muevas el esquema.
DATABASE_SCHEMA=asistia

# -----------------------------------------------------------------------------
# 2. Supabase Auth (identidad de los usuarios del backoffice)
# -----------------------------------------------------------------------------
# Panel de Supabase -> Project Settings -> API Keys.
#
# Supabase renombró las claves en 2025. El código acepta los dos juegos:
#   publishable key (sb_publishable_…)  = la antigua anon key
#   secret key      (sb_secret_…)       = la antigua service_role
NEXT_PUBLIC_SUPABASE_URL=https://PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa aceptada si el proyecto aún usa los nombres antiguos:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta: SOLO servidor, nunca con prefijo NEXT_PUBLIC_. Se usa para
# crear el usuario de Auth cuando Intersim da de alta una empresa (D19).
# Es opcional: sin ella funciona todo menos esa casilla del formulario de alta.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # nombre antiguo, también se acepta

# -----------------------------------------------------------------------------
# 3. Flujo de ingesta (contrato 1: F3 -> A1)
# -----------------------------------------------------------------------------
# Al registrar un documento, el panel avisa al flujo ASI_10_INGESTA:
#
#   POST <ASI_INGESTA_WEBHOOK_URL>
#   X-ASI-Token: <ASI_INGESTA_TOKEN>
#   { "empresa_id": "...", "documento_id": "...", "evento": "INGESTAR" }
#
# `evento` SOLO admite "INGESTAR". Cualquier otro valor devuelve 400.
#
# LAS DOS PUEDEN QUEDAR VACÍAS. El documento se guarda igual, en estado
# PENDIENTE, y el flujo lo recogerá cuando exista: no bloquea nada. Lo único
# que se pierde es el empujón inmediato.
#
# La URL no es secreta (va protegida por el token). El TOKEN sí: lo tiene Rodri
# en la credencial de n8n y lo pasa por canal aparte. Nunca va en el repositorio.
ASI_INGESTA_WEBHOOK_URL=https://cliente.intersim.cloud/webhook/asi-10-ingesta
ASI_INGESTA_TOKEN=

# -----------------------------------------------------------------------------
# 3b. Prueba del agente (contrato 2: F2 -> A2)
# -----------------------------------------------------------------------------
# El botón «Probar» de la configuración del agente. Síncrono: espera a que el
# agente conteste de verdad (3-7 s).
#
#   POST <ASI_PROBAR_WEBHOOK_URL>
#   X-ASI-Token: <ASI_WEBHOOK_TOKEN>
#   { "empresa_id": "...", "texto": "la pregunta de prueba" }
#
# Corre en modo prueba: no escribe nada, no usa memoria y no cuenta contra el
# tope diario de la empresa.
#
# Si queda vacía, el botón lo dice en vez de fallar.
ASI_PROBAR_WEBHOOK_URL=https://cliente.intersim.cloud/webhook/asi-20-probar

# EL TOKEN ES EL MISMO PARA LOS DOS WEBHOOKS. Es la credencial del backoffice
# contra n8n, no la de un flujo. `ASI_INGESTA_TOKEN` se sigue leyendo como
# nombre antiguo, pero el bueno es este.
ASI_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# 4. Opcional
# -----------------------------------------------------------------------------
# Tamaño máximo del pool. Súbelo en un servidor persistente; déjalo bajo en
# serverless, donde cada instancia abre el suyo.
DATABASE_POOL_MAX=5
